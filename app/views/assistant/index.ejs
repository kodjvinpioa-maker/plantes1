<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { title: 'Assistant plantes' }) %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container py-4">
    <div class="text-center mb-4">
      <div class="assistant-avatar"><i class="fa-solid fa-leaf"></i></div>
      <h3 class="mb-1">Assistant plantes</h3>
      <p class="text-muted mb-0">Posez vos questions sur l'entretien, l'arrosage, les maladies…</p>
    </div>

    <div class="card chat-card">
      <div id="chat" class="chat-zone">
        <div class="chat-msg bot">
          Bonjour 🌿 Je suis votre assistant spécialisé en plantes. Demandez-moi par exemple
          « à quelle fréquence arroser un ficus ? » ou « ma plante a des feuilles jaunes ».
        </div>
      </div>
      <form id="chat-form" class="chat-form">
        <input type="text" id="question" class="form-control" maxlength="1000" required
               placeholder="Écrivez votre question…" autocomplete="off">
        <button class="btn btn-primary rounded-pill" type="submit">
          <i class="fa-solid fa-paper-plane"></i>
        </button>
      </form>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-3 justify-content-center">
      <% ['Comment arroser un cactus ?','Feuilles jaunes, que faire ?','Comment rempoter une plante ?','Quelle lumière pour un monstera ?'].forEach(s => { %>
        <button class="btn btn-sm btn-outline-primary rounded-pill suggestion"><%= s %></button>
      <% }) %>
    </div>
  </div>

  <script>
    const csrf = '<%= csrfToken %>';
    const chat = document.getElementById('chat');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('question');
    const historique = [];

    function ajouter(texte, classe) {
      const div = document.createElement('div');
      div.className = 'chat-msg ' + classe;
      div.textContent = texte;
      chat.appendChild(div);
      chat.scrollTop = chat.scrollHeight;
      return div;
    }

    async function envoyer(question) {
      ajouter(question, 'user');
      const attente = ajouter('L\'assistant réfléchit…', 'bot pending');
      try {
        const res = await fetch('/assistant/message', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrf },
          body: JSON.stringify({ question, historique: historique.slice(-6) })
        });
        const data = await res.json();
        attente.remove();
        const reponse = data.reponse || data.error || "Désolé, je n'ai pas pu répondre.";
        ajouter(reponse, 'bot');
        historique.push({ role: 'user', content: question });
        historique.push({ role: 'assistant', content: reponse });
      } catch (e) {
        attente.remove();
        ajouter("Connexion impossible. Réessayez dans un instant.", 'bot');
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      input.value = '';
      envoyer(q);
    });

    document.querySelectorAll('.suggestion').forEach(b => {
      b.addEventListener('click', () => envoyer(b.textContent.trim()));
    });
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
