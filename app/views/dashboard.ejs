<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Tableau de bord' }) %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="dashboard-root">
    <div class="container-fluid py-4 px-3 px-md-4">

      <!-- Top: search + date filters -->
      <div class="d-flex align-items-center gap-3 mb-4">
        <div class="flex-grow-1">
          <div class="input-group search-large">
            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="search" class="form-control search-input" placeholder="Rechercher un produit par nom ou code" aria-label="Recherche produit">
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <label class="small text-muted mb-0 me-1">Du</label>
          <input type="date" class="form-control form-control-sm" value="<%= query.du || '' %>">
          <label class="small text-muted mb-0 ms-2 me-1">Au</label>
          <input type="date" class="form-control form-control-sm" value="<%= query.au || '' %>">
        </div>
        <div class="ms-3">
          <a href="/ventes/nouvelle" class="btn btn-primary btn-lg rounded-pill">
            <i class="fa-solid fa-cart-shopping"></i> Nouvelle vente
          </a>
        </div>
      </div>

      <!-- Monetary cards (grid) -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-sm-4 col-md-3">
          <div class="card card-dark money-card h-100">
            <div class="card-body">
              <div class="card-icon bg-blue-1"><i class="fa-solid fa-wallet"></i></div>
              <p class="card-label">Encaisse</p>
              <p class="card-value"><%= (soldeCaisse || 0).toLocaleString('fr-FR', { maximumFractionDigits: 0 }) %> XOF</p>
              <p class="card-hint text-success small">Entrée</p>
            </div>
          </div>
        </div>

        <div class="col-6 col-sm-4 col-md-3">
          <div class="card card-dark money-card h-100">
            <div class="card-body">
              <div class="card-icon bg-red-1"><i class="fa-solid fa-credit-card"></i></div>
              <p class="card-label">Règlements</p>
              <p class="card-value">0 XOF</p>
              <p class="card-hint text-success small">Entrée</p>
            </div>
          </div>
        </div>

        <div class="col-6 col-sm-4 col-md-3">
          <div class="card card-dark money-card h-100">
            <div class="card-body">
              <div class="card-icon bg-purple-1"><i class="fa-solid fa-box-open"></i></div>
              <p class="card-label">Reliquats</p>
              <p class="card-value">0 XOF</p>
              <p class="card-hint text-danger small">Sortie</p>
            </div>
          </div>
        </div>

        <div class="col-6 col-sm-4 col-md-3">
          <div class="card card-dark money-card h-100">
            <div class="card-body">
              <div class="card-icon bg-orange-1"><i class="fa-solid fa-camera-retro"></i></div>
              <p class="card-label">Dépenses</p>
              <p class="card-value">0 XOF</p>
              <p class="card-hint text-danger small">Sortie</p>
            </div>
          </div>
        </div>

        <div class="col-6 col-sm-4 col-md-3">
          <div class="card card-dark money-card h-100">
            <div class="card-body">
              <div class="card-icon bg-teal-1"><i class="fa-solid fa-basket-shopping"></i></div>
              <p class="card-label">Ventes</p>
              <p class="card-value"><%= ventesDuJour || 0 %> XOF</p>
              <p class="card-hint text-muted small">Valeur théorique</p>
            </div>
          </div>
        </div>

        <div class="col-6 col-sm-4 col-md-3">
          <div class="card card-dark money-card h-100">
            <div class="card-body">
              <div class="card-icon bg-green-1"><i class="fa-solid fa-arrow-down"></i></div>
              <p class="card-label">Réapprovisionnements</p>
              <p class="card-value">0 XOF</p>
              <p class="card-hint text-danger small">Sortie</p>
            </div>
          </div>
        </div>

        <div class="col-6 col-sm-4 col-md-3">
          <div class="card card-dark money-card h-100">
            <div class="card-body">
              <div class="card-icon bg-brown-1"><i class="fa-solid fa-tag"></i></div>
              <p class="card-label">Remise</p>
              <p class="card-value">0 XOF</p>
              <p class="card-hint text-muted small">Pertes probables</p>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-8 col-md-3">
          <div class="card card-highlight money-card h-100">
            <div class="card-body">
              <div class="card-icon bg-highlight"><i class="fa-solid fa-circle-dollar-to-slot"></i></div>
              <p class="card-label">Bénéfices</p>
              <p class="card-value">0 XOF</p>
              <p class="card-hint text-primary small">Résultat</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Small summary row -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="card card-dark h-100">
            <div class="card-body">
              <p class="small text-muted">Produits</p>
              <p class="h4 mb-0"><%= totalProduits || 0 %></p>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card card-dark h-100">
            <div class="card-body">
              <p class="small text-muted">Ventes</p>
              <p class="h4 mb-0"><%= ventesDuJour || 0 %></p>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card card-dark h-100">
            <div class="card-body">
              <p class="small text-muted">Clients</p>
              <p class="h4 mb-0">0</p>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card card-dark h-100">
            <div class="card-body">
              <p class="small text-muted">Fournisseurs</p>
              <p class="h4 mb-0">0</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Evolutions graph -->
      <div class="card card-dark">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
          <strong><i class="fa-solid fa-chart-line text-white"></i> Evolutions des ventes et réapprovisionnement</strong>
        </div>
        <div class="card-body" style="min-height:240px">
          <!-- Placeholder for chart; routes/rapports provides graph data later -->
          <div class="chart-placeholder text-muted">(Graphique ici)</div>
        </div>
      </div>

    </div>
  </div>

  <%- include('partials/toast') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
