<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Tableau de bord' }) %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container-fluid py-4 px-3 px-md-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
      <div>
        <h3 class="mb-1"><i class="fa-solid fa-seedling text-primary"></i> Bonjour !</h3>
        <p class="text-muted mb-0">Voici l'état de votre boutique aujourd'hui.</p>
      </div>
      <a href="/ventes/nouvelle" class="btn btn-primary btn-lg rounded-pill">
        <i class="fa-solid fa-cart-shopping"></i> Nouvelle vente
      </a>
    </div>

    <!-- Indicateurs clés -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-xl-3">
        <div class="card stat-card h-100">
          <div class="card-body">
            <div class="stat-icon bg-soft-green"><i class="fa-solid fa-box"></i></div>
            <p class="stat-label">Produits en stock</p>
            <p class="stat-value"><%= totalProduits %></p>
            <p class="stat-hint"><%= uniteEnStock.toLocaleString('fr-FR') %> unités au total</p>
          </div>
        </div>
      </div>
      <div class="col-6 col-xl-3">
        <div class="card stat-card h-100 <%= totalAlertes > 0 ? 'stat-alert' : '' %>">
          <div class="card-body">
            <div class="stat-icon bg-soft-red"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <p class="stat-label">Alertes stock bas</p>
            <p class="stat-value"><%= totalAlertes %></p>
            <p class="stat-hint">produit(s) sous le seuil</p>
          </div>
        </div>
      </div>
      <div class="col-6 col-xl-3">
        <div class="card stat-card h-100">
          <div class="card-body">
            <div class="stat-icon bg-soft-gold"><i class="fa-solid fa-wallet"></i></div>
            <p class="stat-label">Solde de la caisse</p>
            <p class="stat-value"><%= soldeCaisse.toLocaleString('fr-FR', { maximumFractionDigits: 0 }) %> F</p>
            <p class="stat-hint">mis à jour à chaque vente</p>
          </div>
        </div>
      </div>
      <div class="col-6 col-xl-3">
        <div class="card stat-card h-100">
          <div class="card-body">
            <div class="stat-icon bg-soft-blue"><i class="fa-solid fa-receipt"></i></div>
            <p class="stat-label">Ventes du jour</p>
            <p class="stat-value"><%= ventesDuJour %></p>
            <p class="stat-hint"><%= caDuJour.toLocaleString('fr-FR', { maximumFractionDigits: 0 }) %> F encaissés</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions rapides -->
    <div class="quick-actions mb-4">
      <a href="/ventes/nouvelle" class="quick-action"><i class="fa-solid fa-cart-shopping"></i><span>Vendre</span></a>
      <a href="/stock/entree" class="quick-action"><i class="fa-solid fa-arrow-down"></i><span>Réapprovisionner</span></a>
      <a href="/stock/sortie" class="quick-action"><i class="fa-solid fa-arrow-up"></i><span>Perte / casse</span></a>
      <a href="/caisse" class="quick-action"><i class="fa-solid fa-wallet"></i><span>Caisse</span></a>
      <a href="/produits" class="quick-action"><i class="fa-solid fa-box"></i><span>Produits</span></a>
      <% if (currentUser.role === 'admin') { %>
      <a href="/rapports" class="quick-action"><i class="fa-solid fa-chart-line"></i><span>Rapports</span></a>
      <% } %>
      <a href="/assistant" class="quick-action quick-action-accent"><i class="fa-solid fa-comments"></i><span>Assistant plantes</span></a>
    </div>

    <div class="row g-3">
      <!-- Derniers mouvements -->
      <div class="col-lg-7">
        <div class="card h-100">
          <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
            <strong><i class="fa-solid fa-clock-rotate-left text-primary"></i> Derniers mouvements</strong>
            <a href="/stock/historique" class="btn btn-sm btn-outline-primary rounded-pill">Tout voir</a>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <tbody>
                <% if (derniersMouvements.length === 0) { %>
                  <tr><td class="text-center text-muted py-4">Aucun mouvement pour le moment</td></tr>
                <% } %>
                <% derniersMouvements.forEach(m => { %>
                <tr>
                  <td style="width:56px">
                    <% if (m.photo_url) { %>
                      <img src="<%= m.photo_url %>" alt="" class="miniature-produit">
                    <% } else { %>
                      <div class="miniature-vide"><i class="fa-solid fa-seedling"></i></div>
                    <% } %>
                  </td>
                  <td>
                    <div class="fw-semibold"><%= m.produit_nom || 'Produit supprimé' %></div>
                    <div class="small text-muted"><%= new Date(m.date_mouvement).toLocaleString('fr-FR') %><%= m.user_email ? ' · ' + m.user_email : '' %></div>
                  </td>
                  <td class="text-end">
                    <% if (m.type === 'vente') { %>
                      <span class="badge badge-vente"><i class="fa-solid fa-cart-shopping"></i> Vente</span>
                    <% } else if (m.type === 'entree') { %>
                      <span class="badge badge-entree"><i class="fa-solid fa-arrow-down"></i> Entrée</span>
                    <% } else { %>
                      <span class="badge badge-sortie"><i class="fa-solid fa-arrow-up"></i> Sortie</span>
                    <% } %>
                    <div class="fw-bold mt-1"><%= m.quantite %></div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Alertes stock -->
      <div class="col-lg-5">
        <div class="card h-100">
          <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
            <strong><i class="fa-solid fa-triangle-exclamation text-danger"></i> Stocks à surveiller</strong>
            <a href="/produits" class="btn btn-sm btn-outline-primary rounded-pill">Produits</a>
          </div>
          <ul class="list-group list-group-flush">
            <% if (top5Alertes.length === 0) { %>
              <li class="list-group-item text-center text-muted py-4">
                <i class="fa-solid fa-circle-check text-success"></i> Aucun stock en alerte
              </li>
            <% } %>
            <% top5Alertes.forEach(p => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <div>
                <div class="fw-semibold"><%= p.nom %></div>
                <div class="small text-muted">Réf. <%= p.reference %> · seuil <%= p.seuil_alerte %></div>
              </div>
              <span class="badge badge-alerte">Stock : <%= p.stock_actuel %></span>
            </li>
            <% }) %>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/toast') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
